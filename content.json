    "2": {
      "video": {
        "primary": {"name": "Old MacDonald", "no": "016"}
      },
      "advanced": "进阶词：cow（牛/moo）· duck（鸭子/quack）——加到 Old MacDonald 里多唱两段。进阶句型：\"I see a dog and a cat.\"（一次说两个动物）\"The dog is brown. The cat is white.\"（描述动物颜色——串上周颜色词）进阶绘本：《Brown Bear, Brown Bear, What Do You See?》继续读——上周读了 Red Bird，这周正好把整本书的动物串一遍。",
      "days": [
        {"day": 1, "title": "Dog 日", "rest": false,
         "sections": [
           {"time": "穿衣服", "do": "有小狗图案的衣服就指出来（没有就跳过）", "say": ["Look! A dog on your shirt! Woof woof!"]},
           {"time": "上午（8分钟）", "do": "神秘袋摸狗：毛绒狗放进布袋让她伸手摸，拿出来抱一抱；反复说 dog+woof 让她跟着叫", "say": ["What's in the bag?", "It's a... dog! Woof woof!", "This is a dog."]},
           {"time": "出门", "do": "路上看到狗就指出来", "say": ["Look! A dog! Woof woof! What does the dog say?"]},
           {"time": "晚饭后", "do": "一起趴地上学狗爬学狗叫；唱 Old MacDonald 的 dog 段", "say": ["Let's be a dog!"]}
         ],
         "remember": "狗=dog，叫=woof"},
        {"day": 2, "title": "Cat 日", "rest": false,
         "sections": [
           {"time": "穿衣服", "do": "复习昨天的狗，再拿出毛绒猫介绍今天的主角", "say": ["Remember dog? Woof woof!", "Today we have a cat! Meow!"]},
           {"time": "上午（8分钟）", "do": "狗猫对比：毛绒狗猫并排介绍；你学叫声她指对应动物，反过来你指她学叫", "say": ["This is a dog. This is a cat."]},
           {"time": "睡前", "do": "讲猫狗小故事，然后唱 Old MacDonald 的 dog+cat 两段", "say": ["Dog said woof. Cat said meow. Dog and cat are friends!"]}
         ],
         "remember": "猫=cat，叫=meow"},
        {"day": 3, "title": "休息", "rest": true, "sections": [], "remember": ""},
        {"day": 4, "title": "Bird + Fish 日", "rest": false,
         "sections": [
           {"time": "上午（8分钟）", "do": "动物排队：dog/cat/bird 排成一排，指一个说一个；你说名字她拿起来", "say": ["Dog... cat... bird!", "Give me the bird!"]},
           {"time": "出门", "do": "去湖边/海边看鸟看鱼", "say": ["Look! A bird! Tweet tweet!", "Look in the water! Fish! Blub blub!"]},
           {"time": "晚饭后", "do": "你画一条鱼（简笔画）她涂色，边涂说 Blue fish（顺便复习上周颜色）；唱 Old MacDonald 四段完整版", "say": ["Let's draw a fish!", "Fish! Blue fish!"]}
         ],
         "remember": "鸟=bird/tweet，鱼=fish/blub"},
        {"day": 5, "title": "动物大游行", "rest": false,
         "sections": [
           {"time": "上午（10分钟）", "do": "动物运动会：你说动物名她做动作+叫声（趴下学狗叫、张开手臂飞……），四种动物各做一遍", "say": ["Let's be a dog!", "Let's be a bird!"]},
           {"time": "睡前", "do": "动物猜谜：你学叫声她猜动物，交换她学叫你猜；唱 Old MacDonald 完整版", "say": ["Woof woof! What animal?", "Dog!", "Yes!"]}
         ],
         "remember": "四个动物全部复习一遍"},
        {"day": 6, "title": "休息", "rest": true, "sections": [], "remember": ""},
        {"day": 7, "title": "休息", "rest": true, "sections": [], "remember": ""}
      ]
