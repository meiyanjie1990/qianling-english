    "3": {
      "video": {
        "primary": {"name": "Are You Hungry", "no": "138"}
      },
      "advanced": "进阶词：bread（面包）· water（水）——日常最常用，吃饭时顺手加。进阶句型：\"I want more milk please.\"（加 more + please——教礼貌表达）\"Do you like banana?\" \"Yes, I do. / No, I don't.\"（完整问答）进阶活动：一起做个简单食物：剥香蕉、切苹果（你用刀她看着），过程中全程英文——\"Peel the banana. Cut the apple. Eat!\"",
      "days": [
        {"day": 1, "title": "Milk + Apple 日", "rest": false,
         "sections": [
           {"time": "早餐", "do": "倒牛奶时喝一口夸张地 Mmm；吃苹果时加音效（顺便复习颜色，现在给食物也加音效）", "say": ["Milk! Yummy milk!", "Mmm!", "Apple! Red apple! Crunch crunch!"]},
           {"time": "上午（5分钟）", "do": "真食物展示：苹果和牛奶放桌上，让她摸一摸、假装喝一口；唱 Are You Hungry 的 milk 和 apple 段", "say": ["What's this? Apple!", "And this? Milk!"]},
           {"time": "晚饭后", "do": "吃水果时让她二选一（提前预告明天的词 banana）", "say": ["Do you want an apple or a banana?"]}
         ],
         "remember": "牛奶=milk，苹果=apple"},
        {"day": 2, "title": "Banana + Egg 日", "rest": false,
         "sections": [
           {"time": "早餐", "do": "吃鸡蛋（Yummy egg），剥香蕉时边说 Peel peel peel 边做剥皮动作", "say": ["Egg! Yummy egg!", "Banana! Yellow banana! Peel peel peel!"]},
           {"time": "上午（8分钟）", "do": "食物配对：苹果/香蕉/鸡蛋配卡片，让她把卡片放到对应食物旁，四样各配一次", "say": ["Where is banana?"]},
           {"time": "睡前", "do": "唱 Are You Hungry 四段完整版，复习今天吃的", "say": ["Today we ate banana and egg!"]}
         ],
         "remember": "香蕉=banana，蛋=egg"},
        {"day": 3, "title": "休息", "rest": true, "sections": [], "remember": ""},
        {"day": 4, "title": "食物分类", "rest": false,
         "sections": [
           {"time": "早餐", "do": "指桌上食物复习，四个食物各指一遍等她回答", "say": ["What's this?"]},
           {"time": "上午（8分钟）", "do": "开餐厅：你当服务员她当客人，她说 I want... 就真给她一块，四样各来一轮", "say": ["What do you want? Apple or banana?", "I want apple!"]},
           {"time": "晚饭", "do": "吃饭时指食物复习", "say": ["Milk! Egg! What else?"]}
         ],
         "remember": "\"I want...\" 句型——这是最有用的句型之一"},
        {"day": 5, "title": "食物商店", "rest": false,
         "sections": [
           {"time": "上午（10分钟）", "do": "逛超市：四个食物摆茶几上给她小篮子，你说 I want... 她拿；交换她说你帮她拿", "say": ["Let's go shopping!", "I want milk!", "I want apple!"]},
           {"time": "睡前", "do": "讲食物小故事，唱完歌晚安", "say": ["Once a little girl was hungry. She said 'I want milk!' She drank milk. Then 'I want banana!' She ate banana. Then she was full and happy!"]}
         ],
         "remember": "逛超市游戏——她说\"I want...\"你就给"},
        {"day": 6, "title": "休息", "rest": true, "sections": [], "remember": ""},
        {"day": 7, "title": "休息", "rest": true, "sections": [], "remember": ""}
      ]
    },
    "4": {
      "video": {
        "primary": {"name": "Head Shoulders Knees & Toes", "no": "013"}
      },
      "advanced": "进阶词：hands（手）· feet（脚）——洗澡时最自然。进阶句型：\"I have two eyes.\" \"I have one nose.\"（数词+身体——串数字概念）\"Touch your nose with your finger.\"（更精确的指令）进阶游戏：镜子模仿——站镜子前，你指自己鼻子说 \"Nose!\" 她指镜子里的自己说 \"Nose!\"，五官全部做一遍。",
      "days": [
        {"day": 1, "title": "Eyes + Nose 日", "rest": false,
         "sections": [
           {"time": "穿衣服", "do": "穿好衣服蹲下和她面对面，自己先指眼睛眨给她看；她指了之后确认（眨眼睛）", "say": ["Where are your eyes?", "Yes! Your eyes! Blink blink!"]},
           {"time": "早餐", "do": "拿苹果放她鼻子前闻一闻", "say": ["Let's smell! With your nose!", "Sniff sniff! Your nose smells!"]},
           {"time": "洗澡", "do": "洗脸时边洗边说", "say": ["Wash your eyes! Wash your nose!"]},
           {"time": "睡前", "do": "指五官游戏：你问 my nose 她指你的、your nose 她指自己的，eyes 同样玩；唱五官歌", "say": ["Where is my nose?", "Where is your nose?"]}
         ],
         "remember": "眼睛=eyes（眨），鼻子=nose（嗅）"},
        {"day": 2, "title": "Mouth + Ears 日", "rest": false,
         "sections": [
           {"time": "刷牙", "do": "刷牙时让她张嘴，边刷边说", "say": ["Open your mouth! Let's brush!", "Mouth!", "Brush brush brush your mouth!"]},
           {"time": "早餐", "do": "吃东西时指她的嘴，顺便复习昨天的眼睛和鼻子", "say": ["Yummy in your mouth!", "Where are your eyes? Where is your nose?"]},
           {"time": "上午（5分钟）", "do": "耳朵听声音：拉自己耳朵，再轻声说话、指窗外让她听", "say": ["Where are your ears?", "Listen! What do you hear?", "Your ears hear the bird!"]},
           {"time": "睡前", "do": "唱完整五官歌，速度越来越快，最后快到找不到部位她就笑瘫了", "say": []}
         ],
         "remember": "嘴巴=mouth（吃），耳朵=ears（听）"},
        {"day": 3, "title": "休息", "rest": true, "sections": [], "remember": ""},
        {"day": 4, "title": "五官大考验", "rest": false,
         "sections": [
           {"time": "任何时间", "do": "我说你指（加速版）：连着说五个部位让她指，速度越来越快，她跟不上了就是大笑时刻", "say": ["Touch your nose! Touch your mouth! Touch your ears! Touch your eyes! Touch your head!"]},
           {"time": "上午（8分钟）", "do": "画一张脸：画个大圆（头），问她五官画在哪，一样一样画完整张脸（eyes、nose、mouth、ears）", "say": ["Where do the eyes go?"]},
           {"time": "洗澡", "do": "洗澡时五官全套洗一遍", "say": ["Wash your head! Wash your ears! Wash your nose!"]}
         ],
         "remember": "指认加速——最后一定要快到乱掉才会笑"},
        {"day": 5, "title": "身体大回顾", "rest": false,
         "sections": [
           {"time": "任何时间", "do": "反转版：这次她来说、你来指，她说不出来就小声提醒", "say": []},
           {"time": "上午（8分钟）", "do": "贴五官：打印（或画）空白脸，五官剪成贴片，她说哪个就贴哪个；贴完贴冰箱当本周成果展", "say": ["Eyes!"]},
           {"time": "睡前", "do": "晚安五官：亲着眼睛/鼻子/嘴/耳朵说晚安，然后唱完歌", "say": ["Goodnight, eyes!", "Goodnight, nose!", "Goodnight, mouth!", "Goodnight, ears!"]}
         ],
         "remember": "晚安五官——最温柔的复习方式"},
        {"day": 6, "title": "休息", "rest": true, "sections": [], "remember": ""},
        {"day": 7, "title": "休息", "rest": true, "sections": [], "remember": ""}
      ]
    }
